# Salin ke .env — jangan commit file .env (berisi secret).

# Supabase (sama dengan project web; gunakan service role hanya di server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# URL frontend (untuk link reset password di email)
APP_WEB_URL=http://localhost:3000

# Port API NestJS
PORT=4000

# Opsional: masa berlaku token reset (menit)
# PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
